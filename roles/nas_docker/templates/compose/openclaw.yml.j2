services:
openclaw:
    image: openclaw/openclaw:latest
    container_name: openclaw
    restart: unless-stopped
    command: node openclaw.mjs gateway --allow-unconfigured
    networks:
      - proxy_net
    environment:
      - TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
    volumes:
      - /opt/docker/openclaw/data:/home/node/.openclaw
      - /opt/docker/openclaw/workspace:/home/node/openclaw/workspace

networks:
  proxy_net:
    external: true
