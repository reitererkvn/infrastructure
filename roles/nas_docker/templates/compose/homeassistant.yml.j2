services:
  homeassistant:
    container_name: homeassistant
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, video, compute, utility]
    image: "ghcr.io/home-assistant/home-assistant:stable"
    volumes:
      - /opt/docker/homeassistant/config:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
    restart: unless-stopped
    privileged: true
    network_mode: host
    depends_on:
      - matter-server

  matter-server:
    container_name: matter-server
    image: ghcr.io/matter-js/matterjs-server:stable
    command: --storage-path /data --primary-interface {{ ansible_default_ipv4.interface | default('enp2s0') }} --listen-address 127.0.0.1 --listen-address 172.30.0.1 --production-mode
    restart: unless-stopped
    security_opt:
      - apparmor=unconfined
    volumes:
      - /opt/docker/homeassistant/matter:/data
      - /run/dbus:/run/dbus:ro
    network_mode: host

networks:
  proxy_net:
    external: true
