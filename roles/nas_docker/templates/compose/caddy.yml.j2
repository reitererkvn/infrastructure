services:
  caddy:
    build:
      context: /opt/docker/caddy
      dockerfile: Dockerfile
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "100.72.31.15:3000:3000"
      - "100.72.31.15:3001:3001"
      - "100.72.31.15:3002:3002"
      - "100.72.31.15:3003:3003"
      - "100.72.31.15:9090:9090"
    networks:
      - proxy_net
    env_file:
      - .env
    volumes:
      - /opt/docker/caddy/Caddyfile:/etc/caddy/Caddyfile
      - /opt/docker/caddy/data:/data
      - /opt/docker/caddy/config:/config
      - /var/run/tailscale/tailscaled.sock:/var/run/tailscale/tailscaled.sock
    environment:
      - TZ=Europe/Berlin

networks:
  proxy_net:
    external: true
