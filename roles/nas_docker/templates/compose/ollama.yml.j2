services:
  ollama:
    # Pinned to 0.2.8 (CUDA 11/12) for Pascal GTX 1070 Ti (Compute 6.1, Driver 550);
    # newer ollama:latest (0.40+) requires CUDA 13 / Driver >= 570 and falls back to CPU.
    image: docker.io/ollama/ollama:0.2.8
    container_name: ollama
    restart: unless-stopped
    networks:
      - proxy_net
    ports:
      - "11434:11434"
    volumes:
      - /opt/docker/ollama/data:/root/.ollama
    environment:
      - OLLAMA_NUM_PARALLEL=2
      - OLLAMA_MAX_QUEUE=100
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, video, compute, utility]

networks:
  proxy_net:
    external: true
