services:
{% if current_service == 'semaphore' %}
  semaphore-db:
    image: postgres:15-alpine
    container_name: semaphore-db
    environment:
      POSTGRES_USER: ${SEMAPHORE_DB_USER:-semaphore}
      POSTGRES_PASSWORD: ${SEMAPHORE_DB_PASS}
      POSTGRES_DB: ${SEMAPHORE_DB_NAME:-semaphore}
    volumes:
      - /opt/docker/semaphore/db:/var/lib/postgresql/data
    restart: unless-stopped

  semaphore:
    image: semaphoreui/semaphore:latest
    container_name: semaphore
    networks:
      - proxy_net
      - default
    environment:
      SEMAPHORE_DB_USER: ${SEMAPHORE_DB_USER:-semaphore}
      SEMAPHORE_DB_PASS: ${SEMAPHORE_DB_PASS}
      SEMAPHORE_DB_HOST: semaphore-db
      SEMAPHORE_DB_PORT: "5432"
      SEMAPHORE_DB_DIALECT: postgres
      SEMAPHORE_DB: ${SEMAPHORE_DB_NAME:-semaphore}
      SEMAPHORE_PLAYBOOK_PATH: /home/semaphore/playbooks
      SEMAPHORE_ADMIN_PASSWORD: ${SEMAPHORE_ADMIN_PASS}
      SEMAPHORE_ADMIN_NAME: ${SEMAPHORE_ADMIN_NAME:-Admin}
      SEMAPHORE_ADMIN_EMAIL: ${SEMAPHORE_ADMIN_EMAIL:-admin@example.com}
      SEMAPHORE_ADMIN: ${SEMAPHORE_ADMIN_USER:-admin}
      SEMAPHORE_ACCESS_KEY_ENCRYPTION: ${SEMAPHORE_ACCESS_KEY_ENCRYPTION}
    depends_on:
      - semaphore-db
    volumes:
      - /opt/docker/semaphore/playbooks:/home/semaphore/playbooks
    restart: unless-stopped
{% endif %}

{% if current_service == 'prometheus' %}
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    networks:
      - proxy_net
      - default
    volumes:
      - /opt/docker/prometheus/config:/etc/prometheus
      - /opt/docker/prometheus/data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    restart: unless-stopped

  node-exporter-nas:
    image: prom/node-exporter:latest
    container_name: node-exporter-nas
    ports:
      - "9101:9100"
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - '--path.procfs=/host/proc'
      - '--path.sysfs=/host/sys'
      - '--collector.filesystem.ignored-mount-points=^/(sys|proc|dev|host|etc)($$|/)'
    restart: unless-stopped
{% endif %}

{% if current_service == 'grafana' %}
  grafana:
    image: grafana/grafana-oss:latest
    container_name: grafana
    networks:
      - proxy_net
    volumes:
      - /opt/docker/grafana/data:/var/lib/grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASS}
    restart: unless-stopped
{% endif %}

{% if current_service == 'homeassistant' %}
  homeassistant:
    container_name: homeassistant
    image: "ghcr.io/home-assistant/home-assistant:stable"
    volumes:
      - /opt/docker/homeassistant/config:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
    restart: unless-stopped
    privileged: true
    network_mode: host
    depends_on:
      - matter-server

  matter-server:
    container_name: matter-server
    image: ghcr.io/home-assistant-libs/python-matter-server:stable
    command: --storage-path /data --paa-root-cert-dir /data/credentials --primary-interface enp1s0
    restart: unless-stopped
    security_opt:
      - apparmor=unconfined
    volumes:
      - /opt/docker/homeassistant/matter:/data
      - /run/dbus:/run/dbus:ro
    network_mode: host
{% endif %}

{% if current_service == 'caddy' %}
  caddy:
    build:
      context: /opt/docker/caddy
      dockerfile: Dockerfile
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    networks:
      - proxy_net
    env_file:
      - .env
    volumes:
      - /opt/docker/caddy/Caddyfile:/etc/caddy/Caddyfile
      - /opt/docker/caddy/data:/data
      - /opt/docker/caddy/config:/config
      - /var/run/tailscale/tailscaled.sock:/var/run/tailscale/tailscaled.sock
    environment:
      - TZ=Europe/Berlin
{% endif %}

{% if current_service == 'openclaw' %}
  openclaw:
    image: openclaw/openclaw:latest
    container_name: openclaw
    restart: unless-stopped
    command: node openclaw.mjs gateway --allow-unconfigured
    networks:
      - proxy_net
    environment:
      - TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
    volumes:
      - /opt/docker/openclaw/data:/home/node/.openclaw
      - /opt/docker/openclaw/workspace:/home/node/openclaw/workspace
{% endif %}

{% if current_service == 'vaultwarden' %}
  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    restart: unless-stopped
    networks:
      - proxy_net
    environment:
      - SIGNUPS_ALLOWED=false
    volumes:
      - /opt/docker/vaultwarden/data:/data
{% endif %}

{% if current_service == 'immich' %}
{% if inventory_hostname == 'nas-01' %}
  immich-server:
    container_name: immich_server
    image: ghcr.io/immich-app/immich-server:release
    volumes:
      - ${UPLOAD_LOCATION}:/data
      - /etc/localtime:/etc/localtime:ro
    env_file:
      - .env
    networks:
      - proxy_net
      - default
    depends_on:
      - redis
      - database
    restart: always
    healthcheck:
      disable: false

  immich-machine-learning:
    container_name: immich_machine_learning
    image: ghcr.io/immich-app/immich-machine-learning:release-cuda
    volumes:
      - /opt/docker/immich/model-cache:/cache
    environment:
      - TZ=Europe/Vienna
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, video, compute, utility]
    restart: always

  redis:
    container_name: immich_redis
    image: docker.io/valkey/valkey:9@sha256:3b55fbaa0cd93cf0d9d961f405e4dfcc70efe325e2d84da207a0a8e6d8fde4f9
    healthcheck:
      test: redis-cli ping || exit 1
    restart: always

  database:
    container_name: immich_postgres
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
    environment:
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_DB: ${DB_DATABASE_NAME}
      POSTGRES_INITDB_ARGS: '--data-checksums'
    volumes:
      - ${DB_DATA_LOCATION}:/var/lib/postgresql/data
    shm_size: 128mb
    restart: always
    healthcheck:
      disable: false
{% endif %}
{% endif %}
{% if current_service == 'cloudflared' %}
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared
    restart: unless-stopped
    command: tunnel run
    environment:
      - TUNNEL_TRANSPORT_PROTOCOL=http2
    env_file:
      - .env
    networks:
      - proxy_net
{% endif %}

{% if current_service == 'adguard' %}
  adguard:
    image: adguard/adguardhome
    container_name: adguard
    restart: unless-stopped
    networks:
      - proxy_net
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "3002:3000/tcp"
      - "8081:80/tcp"
    volumes:
      - /opt/docker/adguard/work:/opt/adguardhome/work
      - /opt/docker/adguard/conf:/opt/adguardhome/conf
{% endif %}

{% if current_service == 'paperless' %}
  paperless-broker:
    image: docker.io/library/redis:7
    container_name: paperless_redis
    restart: unless-stopped
    volumes:
      - /opt/docker/paperless/redis:/data

  paperless-db:
    image: docker.io/library/postgres:15
    container_name: paperless_db
    restart: unless-stopped
    volumes:
      - /opt/docker/paperless/db:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: paperless
      POSTGRES_USER: paperless
      POSTGRES_PASSWORD: ${PAPERLESS_DB_PASS}

  paperless-webserver:
    image: ghcr.io/paperless-ngx/paperless-ngx:latest
    container_name: paperless_webserver
    restart: unless-stopped
    networks:
      - proxy_net
      - default
    depends_on:
      - paperless-db
      - paperless-broker
    healthcheck:
      test: ["CMD", "curl", "-fs", "-S", "--max-time", "2", "http://localhost:8000"]
      interval: 30s
      timeout: 10s
      retries: 5
    volumes:
      - /opt/docker/paperless/data:/usr/src/paperless/data
      - /mnt/HDD-01/paperless/media:/usr/src/paperless/media
      - /opt/docker/paperless/export:/usr/src/paperless/export
      - /opt/docker/paperless/consume:/usr/src/paperless/consume
      - /opt/docker/paperless/tmp:/tmp/paperless
    env_file:
      - .env
    environment:
      PAPERLESS_REDIS: redis://paperless-broker:6379
      PAPERLESS_DBHOST: paperless-db
      PAPERLESS_DBPASS: ${PAPERLESS_DB_PASS}
      PAPERLESS_URL: https://docs.rnet.at
      PAPERLESS_SECRET_KEY: ${PAPERLESS_SECRET_KEY}
      PAPERLESS_EMAIL_CHARSET: US-ASCII
{% endif %}

{% if current_service == 'ollama' %}
  ollama:
    image: docker.io/ollama/ollama:0.2.8
    container_name: ollama
    restart: unless-stopped
    ports:
      - "11434:11434"
    volumes:
      - /opt/docker/ollama/data:/root/.ollama
    environment:
      - OLLAMA_NUM_PARALLEL=2
      - OLLAMA_MAX_QUEUE=100
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, video, compute, utility]
{% endif %}

networks:
  proxy_net:
    external: true
